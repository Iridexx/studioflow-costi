// Modello dati di StudioFlow Costi: spese, ore e versamenti dei soci per lo sviluppo di StudioFlow.
// Gli importi sono in centesimi di euro, le ore in minuti.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Socio o collaboratore allo sviluppo. Con nome utente e password può entrare nel programma.
model Partner {
  id                 String         @id @default(cuid())
  name               String
  username           String?        @unique
  passwordHash       String?
  // Password provvisoria scelta dall'amministratore: al primo accesso il socio deve cambiarla.
  mustChangePassword Boolean        @default(false)
  // Solo per preparare l'email con le credenziali.
  email              String?
  isAdmin            Boolean        @default(false)
  active             Boolean        @default(true)
  // Quota di partecipazione alle spese, in centesimi di punto (5000 = 50%).
  shareBasisPoints   Int            @default(0)
  // Costo orario usato per valorizzare le ore di lavoro.
  hourlyRateCents    Int            @default(0)
  // Dati per l'accordo tra soci: li compila ogni socio dalla pagina "Accordo".
  taxCode            String?
  birthPlace         String?
  birthDate          DateTime?      @db.Date
  residence          String?
  // Parte nell'accordo (A sviluppo, B commerciale); la sceglie l'amministratore.
  agreementRole      AgreementRole? @unique
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  sessions        Session[]
  expensesPaid    Expense[]           @relation("ExpensePaidBy")
  expensesCreated Expense[]           @relation("ExpenseCreatedBy")
  timeEntries     TimeEntry[]         @relation("TimeEntryPartner")
  timeCreated     TimeEntry[]         @relation("TimeEntryCreatedBy")
  contributions   Contribution[]      @relation("ContributionPartner")
  contribCreated  Contribution[]      @relation("ContributionCreatedBy")
  approvals       ExpenseApproval[]
  expenseMessages ExpenseMessage[]
  timeApprovals   TimeEntryApproval[]
  agreementEdits  AgreementVersion[]
  agreementOks    AgreementApproval[]
}

enum AgreementRole {
  A
  B
}

model Session {
  id        String   @id @default(cuid())
  // Hash SHA-256 del valore del cookie: il valore vero resta solo nel browser.
  tokenHash String   @unique
  partnerId String
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([partnerId])
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  position Int       @default(0)
  active   Boolean   @default(true)
  expenses Expense[]
}

enum Recurrence {
  ONE_OFF
  MONTHLY
  YEARLY
}

// Una voce di spesa. Se è ricorrente vale ogni mese (o anno) dalla data di inizio fino alla
// data di fine, se indicata.
model Expense {
  id                     String            @id @default(cuid())
  date                   DateTime          @db.Date
  endDate                DateTime?         @db.Date
  description            String
  supplier               String?
  categoryId             String
  category               Category          @relation(fields: [categoryId], references: [id])
  // Importo pagato, IVA inclusa.
  amountCents            Int
  // Aliquota IVA in centesimi di punto (2200 = 22%), solo per calcolare l'imponibile.
  vatBasisPoints         Int               @default(0)
  recurrence             Recurrence        @default(ONE_OFF)
  // Chi l'ha pagata di tasca propria. Vuoto = pagata dalla cassa comune.
  paidById               String?
  paidBy                 Partner?          @relation("ExpensePaidBy", fields: [paidById], references: [id])
  // Parte del costo a carico della Parte B dell'accordo, in centesimi di punto (7000 = 70%); il
  // resto è della Parte A. Vuoto = il costo si divide secondo le quote dei soci.
  partyBShareBasisPoints Int?
  notes                  String?
  createdById            String
  createdBy              Partner           @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  // Entra nei conti solo quando tutti i soci con accesso l'hanno approvata. Vuoto = in attesa.
  approvedAt             DateTime?
  approvals              ExpenseApproval[]
  messages               ExpenseMessage[]

  @@index([date])
}

// "Approvo" di un socio su una spesa. Chi la inserisce o la modifica la approva in automatico;
// una modifica cancella le approvazioni e la spesa torna in attesa.
model ExpenseApproval {
  id        String   @id @default(cuid())
  expenseId String
  expense   Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  partnerId String
  partner   Partner  @relation(fields: [partnerId], references: [id])
  createdAt DateTime @default(now())

  @@unique([expenseId, partnerId])
}

// Messaggi tra soci su una spesa, per chiedere e dare spiegazioni prima di approvarla.
model ExpenseMessage {
  id        String   @id @default(cuid())
  expenseId String
  expense   Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  authorId  String
  author    Partner  @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([expenseId, createdAt])
}

model TimeEntry {
  id              String              @id @default(cuid())
  date            DateTime            @db.Date
  partnerId       String
  partner         Partner             @relation("TimeEntryPartner", fields: [partnerId], references: [id])
  minutes         Int
  topic           String
  notes           String?
  // Costo orario del socio nel giorno della registrazione (non cambia se poi cambia la tariffa).
  hourlyRateCents Int
  createdById     String
  createdBy       Partner             @relation("TimeEntryCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime            @default(now())
  // Come le spese: entrano nei conti quando le hanno confermate tutti i soci. Vuoto = in attesa.
  approvedAt      DateTime?
  approvals       TimeEntryApproval[]

  @@index([date])
}

// "Confermo" di un socio sulle ore registrate. Chi le inserisce o le modifica conferma in automatico.
model TimeEntryApproval {
  id          String    @id @default(cuid())
  timeEntryId String
  timeEntry   TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
  partnerId   String
  partner     Partner   @relation(fields: [partnerId], references: [id])
  createdAt   DateTime  @default(now())

  @@unique([timeEntryId, partnerId])
}

// Soldi messi da un socio nella cassa comune.
model Contribution {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  partnerId   String
  partner     Partner  @relation("ContributionPartner", fields: [partnerId], references: [id])
  amountCents Int
  notes       String?
  createdById String
  createdBy   Partner  @relation("ContributionCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([date])
}

model Setting {
  key   String @id
  value String
}

// Argomenti delle ore, proposti nel menu a tendina. Uno nuovo scritto registrando le ore si
// aggiunge da solo; da Impostazioni si rinominano o si tolgono dal menu.
model TimeTopic {
  id       String  @id @default(cuid())
  name     String  @unique
  position Int     @default(0)
  active   Boolean @default(true)
}

// Versioni dell'accordo tra soci. Ogni modifica salva una versione nuova (le precedenti restano
// com'erano); la prima nasce da docs/accordo-soci.md. Quando tutti i soci con accesso hanno
// convalidato l'ultima versione, questa diventa definitiva e il testo non si modifica più.
model AgreementVersion {
  id                String              @id @default(cuid())
  number            Int                 @unique
  text              String
  // Cosa è cambiato, scritto da chi ha salvato la versione.
  note              String
  // Vuoto per la prima versione, presa dal file.
  authorId          String?
  author            Partner?            @relation(fields: [authorId], references: [id])
  createdAt         DateTime            @default(now())
  finalizedAt       DateTime?
  // Richiesta di riaprire un accordo definitivo: si riapre quando la confermano tutti i soci.
  reopenReason      String?
  reopenRequestedAt DateTime?
  reopenedAt        DateTime?
  approvals         AgreementApproval[]
}

enum AgreementApprovalKind {
  VALIDATE
  REOPEN
}

// "Convalido" di un socio su una versione (chi la salva la convalida in automatico), oppure
// "Sono d'accordo" sulla richiesta di riaprirla (chi la chiede è d'accordo in automatico).
model AgreementApproval {
  id        String                @id @default(cuid())
  versionId String
  version   AgreementVersion      @relation(fields: [versionId], references: [id], onDelete: Cascade)
  partnerId String
  partner   Partner               @relation(fields: [partnerId], references: [id])
  kind      AgreementApprovalKind @default(VALIDATE)
  createdAt DateTime              @default(now())

  @@unique([versionId, partnerId, kind])
}
