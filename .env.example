# Copia questo file in .env e completa i valori.

# Database di StudioFlow Costi: stesso PostgreSQL di StudioFlow, database separato.
# Lo script di aggiornamento lo crea da solo se non esiste.
DATABASE_URL="postgresql://studioflow:studioflow@localhost:5432/studioflow_costi"

# Cartella dove salvare il backup notturno (meglio se sincronizzata, es. OneDrive).
# Se vuota, i backup vanno nella cartella "backup" del programma.
COSTI_BACKUP_DIR=""

# Altri nomi o indirizzi da cui aprire il programma oltre a localhost e alla rete Tailscale
# (servono solo in sviluppo), separati da virgola.
COSTI_ALLOWED_HOSTS=""
